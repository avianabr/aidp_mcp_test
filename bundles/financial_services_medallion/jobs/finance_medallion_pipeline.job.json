{
  "runAs": null,
  "name": "${publish.resource_name_prefix}finance_medallion_pipeline${publish.resource_name_suffix}",
  "description": "Pipeline financeiro modular: Bronze → Silver → Gold → treinamento; dados sintéticos.",
  "schedule": null,
  "continuous": null,
  "maxConcurrentRuns": 1,
  "gitConfig": null,
  "queue": null,
  "path": null,
  "jobClusters": null,
  "tasks": [
    {
      "type": "NOTEBOOK_TASK",
      "taskKey": "bronze",
      "dependsOn": [],
      "runIf": "ALL_SUCCESS",
      "maxRetries": 0,
      "minRetryIntervalMillis": null,
      "isRetryOnTimeout": null,
      "notebookPath": "${publish.path}/artifacts/notebooks/bronze.ipynb",
      "source": "WORKSPACE",
      "gitConfig": null,
      "cluster": {
        "clusterKey": "${var.compute_key}"
      },
      "parameters": [
        {
          "name": "DATASET_ID",
          "value": "${var.dataset_id}"
        },
        {
          "name": "CATALOG_NAME",
          "value": "${var.catalog_name}"
        },
        {
          "name": "ACCOUNT_COUNT",
          "value": "${var.account_count}"
        },
        {
          "name": "SEED",
          "value": "${var.seed}"
